# ============================================================================
# Utero Indonesia - Environment Variables
# ============================================================================
# Copy file ini ke .env dan sesuaikan dengan konfigurasi kamu
#
# JANGAN commit file .env ke git!
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Configuration (Self-Hosted)
# ----------------------------------------------------------------------------
# URL dari self-hosted Supabase instance
# Contoh: https://supabase.yourdomain.com
VITE_SUPABASE_URL=your-supabase-project-url

# Anon key dari Supabase instance
# Dapatkan dari: docker/.env di server, variable ANON_KEY
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (OPTIONAL - hanya untuk admin operations)
# WARNING: Jangan expose di client-side!
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Blog API Configuration
# ----------------------------------------------------------------------------
# Endpoint untuk blog auto-post function
VITE_BLOG_API_ENDPOINT=https://your-supabase-domain.com/functions/v1/blog-auto-post


# ----------------------------------------------------------------------------
# Optional: Analytics & Monitoring
# ----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN untuk error tracking
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ----------------------------------------------------------------------------
# Optional: Feature Flags
# ----------------------------------------------------------------------------
# Enable/disable features
# VITE_ENABLE_BLOG=true
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DARK_MODE=false

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Development mode
# VITE_DEV_MODE=true

# API base URL (override default)
# VITE_API_BASE_URL=http://localhost:54321

# ----------------------------------------------------------------------------
# Server-Side Environment Variables (Self-Hosted Supabase)
# ----------------------------------------------------------------------------
# These should be set on the server at:
# ~/docker/supabase/supabase-1.26.05/docker/volumes/functions/.env
#
# BLOG_API_KEY=same-as-VITE_BLOG_API_KEY-above
# SUPABASE_SERVICE_ROLE_KEY=from-main-docker-env
#
# Cara mendapatkan keys di server:
# ssh maskhar@supabase-server
# cd ~/docker/supabase/supabase-1.26.05/docker
# grep "ANON_KEY\|SERVICE_ROLE_KEY" .env
# ----------------------------------------------------------------------------

# ============================================================================
# Notes:
# ============================================================================
# 1. File ini adalah template. Copy ke .env dan isi dengan nilai yang benar.
# 2. VITE_* prefix diperlukan agar variabel bisa diakses di client-side Vite
# 3. Jangan commit file .env ke repository (sudah di .gitignore)
# 4. Untuk production, set environment variables di hosting platform
# 5. Generate secure keys dengan: openssl rand -base64 32
# ============================================================================
